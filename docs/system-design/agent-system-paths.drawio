 as="sourcePoint"/><mxPoint x="1610" y="538.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow5" value="5 · queries · imports" style="endArrow=block;endFill=1;html=1;strokeColor=#5b6577;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#5b6577;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="base"><mxGeometry relative="1" as="geometry"><mxPoint x="1670" y="428.0" as="sourcePoint"/><mxPoint x="1670" y="648.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow6" value="6 · fetches · sends" style="endArrow=block;endFill=1;html=1;strokeColor=#5b6577;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#5b6577;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="base"><mxGeometry relative="1" as="geometry"><mxPoint x="1730" y="428.0" as="sourcePoint"/><mxPoint x="1730" y="758.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow7" value="7 · prompts" style="endArrow=block;endFill=1;html=1;strokeColor=#5b6577;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#5b6577;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="base"><mxGeometry relative="1" as="geometry"><mxPoint x="1790" y="428.0" as="sourcePoint"/><mxPoint x="1790" y="868.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow8" value="8 · results + origins" style="endArrow=block;endFill=1;html=1;strokeColor=#4d7c0f;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="base"><mxGeometry relative="1" as="geometry"><mxPoint x="1850" y="758.0" as="sourcePoint"/><mxPoint x="1850" y="318.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="flow9" value="9 · answer, cited" style="endArrow=block;endFill=1;html=1;strokeColor=#2f6fdf;strokeWidth=2.5;fontSize=11;fontStyle=1;fontColor=#2f6fdf;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="base"><mxGeometry relative="1" as="geometry"><mxPoint x="1910" y="318.0" as="sourcePoint"/><mxPoint x="1910" y="188.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step1" value="&lt;b&gt;&lt;font color=&quot;#2f6fdf&quot; style=&quot;font-size:14px&quot;&gt;1 · asks&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;A person asks an agent — a user asks the router, a data modeler asks the modeler.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40.0" y="976" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step2" value="&lt;b&gt;&lt;font color=&quot;#8250d8&quot; style=&quot;font-size:14px&quot;&gt;2 · hands off&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The router hands a plan to the agent that fits: analyst, research, modeler or coder.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="750.0" y="976" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step3" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot; style=&quot;font-size:14px&quot;&gt;3 · follows a skill&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The agent follows a skill; its callables run on a worker.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1460.0" y="976" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step4" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot; style=&quot;font-size:14px&quot;&gt;4 · reads · designs the model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Read the graph model — or design it, and map a dataset onto it.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40.0" y="1038" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step5" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot; style=&quot;font-size:14px&quot;&gt;5 · queries · imports&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Query the knowledge graph or a dataset; an import writes mapped records.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="750.0" y="1038" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step6" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot; style=&quot;font-size:14px&quot;&gt;6 · fetches · sends&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Reach outside through a connector; the response is kept as an artifact.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1460.0" y="1038" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step7" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot; style=&quot;font-size:14px&quot;&gt;7 · prompts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The LLM reasons over what was found. It is never the source.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40.0" y="1100" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step8" value="&lt;b&gt;&lt;font color=&quot;#4d7c0f&quot; style=&quot;font-size:14px&quot;&gt;8 · results + origins&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Every result comes back up with where it came from.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="750.0" y="1100" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="step9" value="&lt;b&gt;&lt;font color=&quot;#2f6fdf&quot; style=&quot;font-size:14px&quot;&gt;9 · answer, cited&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The person gets an answer that cites every claim — or says it cannot answer.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1460.0" y="1100" width="690.0" height="50" as="geometry"/></mxCell><mxCell id="lgh" value="&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; color=&quot;#8691a2&quot;&gt;&lt;b&gt;PATHS&lt;/b&gt;&lt;/font&gt;   &lt;font color=&quot;#4f5a6b&quot;&gt;a colour is one path through the entities above&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=12;" vertex="1" parent="base"><mxGeometry x="40" y="1266" width="1600" height="24" as="geometry"/></mxCell><mxCell id="lg0" value="&lt;b&gt;&lt;font color=&quot;#2f6fdf&quot;&gt;━━ Ask and answer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;A user asks; the router composes an answer from the agents’ results and shows it.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40" y="1298" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;&lt;font color=&quot;#8250d8&quot;&gt;━━ Hand off&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The router hands a plan to a specialist or the modeler agent and gets the result back.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="740" y="1298" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;&lt;font color=&quot;#5b6577&quot;&gt;━━ Execute&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;An agent follows a skill; its callables run on a worker against the graph and outside services.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1440" y="1298" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;&lt;font color=&quot;#c2417a&quot;&gt;━━ Model and import&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;A source becomes a dataset, the dataset is mapped to a graph model, and the import writes the graph.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40" y="1346" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg4" value="&lt;b&gt;&lt;font color=&quot;#4d7c0f&quot;&gt;━━ Cite the origin&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Every claim points to a graph record, a dataset row or an artifact. No source, no claim.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="740" y="1346" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg5" value="&lt;b&gt;&lt;font color=&quot;#c27a0e&quot;&gt;━━ Trace&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Every run and every touch is recorded, and streamed to the dashboard.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1440" y="1346" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg6" value="&lt;b&gt;&lt;font color=&quot;#23935a&quot;&gt;━━ Evaluate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;A skill change is benchmarked; a worse score blocks it from shipping.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="40" y="1394" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg7" value="&lt;b&gt;&lt;font color=&quot;#0f8a93&quot;&gt;━━ Deploy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;A worker is deployed anywhere and registers the callables it can run.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="740" y="1394" width="680" height="40" as="geometry"/></mxCell><mxCell id="lg8" value="&lt;b&gt;&lt;font color=&quot;#b42318&quot;&gt;━━ Govern access&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;An access policy says who may do what, on which resource; checked at bind, plan, dispatch and call.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="base"><mxGeometry x="1440" y="1394" width="680" height="40" as="geometry"/></mxCell><mxCell id="ch" value="&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; color=&quot;#8691a2&quot;&gt;&lt;b&gt;EVERY CLAIM TRACES TO ITS ORIGIN&lt;/b&gt;&lt;/font&gt;   &lt;font color=&quot;#4f5a6b&quot;&gt;the LLM reasons; it is never the source. A claim with no origin is not said.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=12;" vertex="1" parent="L_cites"><mxGeometry x="40" y="1466" width="1600" height="24" as="geometry"/></mxCell><mxCell id="ctc0" value="&lt;b style=&quot;font-size:14px&quot;&gt;From the graph&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;a fact the knowledge graph holds&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#4d7c0f&quot;&gt;● Cite the origin&lt;/font&gt; · &lt;font color=&quot;#c2417a&quot;&gt;● Model and import&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_cites"><mxGeometry x="40" y="1512" width="290" height="64" as="geometry"/></mxCell><mxCell id="cts0_0" value="&lt;b&gt;Answer&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="370" y="1522.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts0_1" value="&lt;b&gt;Graph record&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="680" y="1522.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts0_2" value="&lt;b&gt;Graph database&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#eef7f1;strokeColor=#4d7c0f;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="990" y="1522.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts0_3" value="&lt;b&gt;Dataset&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="1300" y="1522.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts0_4" value="&lt;b&gt;Sources&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#8691a2;dashed=1;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="1610" y="1522.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cta0_0" value="cites" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts0_0" target="cts0_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cta0_1" value="stored in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts0_1" target="cts0_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cta0_2" value="imported from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#c2417a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#c2417a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts0_2" target="cts0_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cta0_3" value="loaded from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#c2417a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#c2417a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts0_3" target="cts0_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctc1" value="&lt;b style=&quot;font-size:14px&quot;&gt;From a dataset&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;a row not yet in the graph&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#4d7c0f&quot;&gt;● Cite the origin&lt;/font&gt; · &lt;font color=&quot;#c2417a&quot;&gt;● Model and import&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_cites"><mxGeometry x="40" y="1604" width="290" height="64" as="geometry"/></mxCell><mxCell id="cts1_0" value="&lt;b&gt;Answer&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="370" y="1614.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts1_1" value="&lt;b&gt;Dataset row&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="680" y="1614.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts1_2" value="&lt;b&gt;Dataset&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="990" y="1614.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts1_3" value="&lt;b&gt;Sources&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#8691a2;dashed=1;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="1300" y="1614.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cta1_0" value="cites" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts1_0" target="cts1_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cta1_1" value="part of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts1_1" target="cts1_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cta1_2" value="loaded from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#c2417a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#c2417a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts1_2" target="cts1_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctc2" value="&lt;b style=&quot;font-size:14px