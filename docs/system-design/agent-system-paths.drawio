x 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;user/… · group/… · approval/&amp;lt;kind&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;agent:invoke · skill:offer · human:answer&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;who may use which agent · only the owner approves spend over $50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Agents&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;agent/&amp;lt;name&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;agent:invoke · agent:delegate&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;child grant ⊆ parent grant · max depth 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Skills&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;skill/&amp;lt;name&amp;gt;@&amp;lt;version&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;skill:offer · skill:edit · skill:publish&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;publish only with a passing scorecard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Callables&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;callable/&amp;lt;step_key&amp;gt; · bound/&amp;lt;bound&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;callable:run&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;args.model = Supplier · bound = graph_read&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;model/&amp;lt;name&amp;gt;@&amp;lt;version&amp;gt; · schema/&amp;lt;dataset&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;model:read · schema:write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;only a data modeler publishes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Data&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;graph/&amp;lt;db&amp;gt;/&amp;lt;model&amp;gt;/&amp;lt;type&amp;gt; · dataset/&amp;lt;name&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;data:read · data:write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;properties ⊄ {salary, ssn}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Connectors&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;source/&amp;lt;connection&amp;gt; · api/… · web/… · mail/…&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read · connector:send&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;source = snowflake/finance · mail.to ends with @acme.com&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;LLM&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;llm/&amp;lt;provider&amp;gt;/&amp;lt;model&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;llm:prompt&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;tokens ≤ 50k per run · no customer data out&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;b&gt;Workers&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;worker/&amp;lt;pool&amp;gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#b42318&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;worker:lease · code:exec&lt;/font&gt;&lt;/td&gt