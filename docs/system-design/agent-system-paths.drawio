=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="1900" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_answer" value="&lt;b style=&quot;font-size:14px&quot;&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;every claim cited&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="40" y="270" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_run" value="&lt;b style=&quot;font-size:14px&quot;&gt;Run&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;one execution · nests&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="350" y="270" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_builder" value="&lt;b style=&quot;font-size:14px&quot;&gt;Builder&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;writes skills and callables&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#eef3ff;strokeColor=#4f5a6b;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="970" y="270" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_artifact" value="&lt;b style=&quot;font-size:14px&quot;&gt;Artifact&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;request · response · snapshot&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vert