geStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#23935a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#23935a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_eval" source="e_builder" target="e_skill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r29" value="defines cases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#23935a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#23935a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_eval" source="e_evaluator" target="e_bench"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r30" value="tests · gates publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#23935a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#23935a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_eval" source="e_bench" target="e_skill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r31" value="scores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#23935a;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#23935a;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_eval" source="e_bench" target="e_score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r32" value="deploys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#0f8a93;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#0f8a93;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_deploy" source="e_platform" target="e_worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r33" value="registers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#0f8a93;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#0f8a93;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_deploy" source="e_worker" target="e_callable"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r34" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_policy" source="e_admin" target="e_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r35" value="checked on every" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_policy" source="e_policy" target="e_run"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Backend architecture" id="backend"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2300" pageHeight="1420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="be_title" value="&lt;b style=&quot;font-size:22px&quot;&gt;Backend architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;The engine decides and records; workers do the work, anywhere. Solid is built today, dashed is designed. Every arrow out of the system passes the policy engine and lands in the record.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="56" as="geometry"/></mxCell><mxCell id="g_clients" value="&lt;b style=&quot;font-size:14px&quot;&gt;CLIENTS&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#4f5a6b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="2220" height="110" as="geometry"/></mxCell><mxCell id="g_engine" value="&lt;b style=&quot;font-size:14px&quot;&gt;engine — control plane&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;FastAPI · Python 3.14 · REST + SSE at /api/v1&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#4f5a6b;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="1600" height="800" as="geometry"/></mxCell><mxCell id="g_orch" value="&lt;b style=&quot;font-size:13px&quot;&gt;Orchestration&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;who does the work, in what order&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="310" y="340" width="640" height="280" as="geometry"/></mxCell><mxCell id="g_know" value="&lt;b style=&quot;font-size:13px&quot;&gt;Knowledge&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;what things are, what we hold, where it came from&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="970" y="340" width="650" height="280" as="geometry"/></mxCell><mxCell id="g_gate" value="&lt;b style=&quot;font-size:13px&quot;&gt;Gateways — every call out&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;policy-checked, recorded, snapshotted&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="310" y="640" width="640" height="240" as="geometry"/></mxCell><mxCell id="g_rec" value="&lt;b style=&quot;font-size:13px&quot;&gt;Record and quality&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;what happened, and was it good&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="970" y="640" width="650" height="360" as="geometry"/></mxCell><mxCell id="g_sched" value="&lt;b style=&quot;font-size:13px&quot;&gt;Scheduling&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;when work runs, and where&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="310" y="895" width="640" height="115" as="geometry"/></mxCell><mxCell id="g_plane" value="&lt;b style=&quot;font-size:14px&quot;&gt;data plane — workers, anywhere&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;pull work from the queue; run @callables&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#4f5a6b;" vertex="1" parent="1"><mxGeometry x="1680" y="220" width="580" height="800" as="geometry"/></mxCell><mxCell id="g_remote" value="&lt;b style=&quot;font-size:13px&quot;&gt;Remote worker&lt;/b&gt;  &lt;font color=&quot;#8691a2&quot; style=&quot;font-size:11px&quot;&gt;your machine, your network&lt;/font&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#8691a2;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="1"><mxGeometry x="1700" y="520" width="540" height="250" as="geometry"/></mxCell><mxCell id="g_state" value="&lt;b style=&quot;font-size:14px&quot;&gt;STATE&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#4f5a6b;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="2220" height="170" as="geometry"/></mxCell><mxCell id="g_out" value="&lt;b style=&quot;font-size:14px&quot;&gt;OUTSIDE&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#4f5a6b;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="2220" height="150" as="geometry"/></mxCell><mxCell id="be_studio" value="&lt;b style=&quot;font-size:13px&quot;&gt;Studio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;React SPA · dashboard · run detail&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="115" width="280" height="60" as="geometry"/></mxCell><mxCell id="be_cli" value="&lt;b style=&quot;font-size:13px&quot;&gt;invana CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;start · migrate · loader&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="115" width="280" height="60" as="geometry"/></mxCell><mxCell id="be_callers" value="&lt;b style=&quot;font-size:13px&quot;&gt;API callers · external agents&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;REST · personal access tokens&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1160" y="115" width="320" height="60" as="geometry"/></mxCell><mxCell id="be_api" value="&lt;b style=&quot;font-size:13px&quot;&gt;API — /api/v1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;REST + SSE · authenticates every call: JWT · SSO · personal access tokens&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="1520" height="50" as="geometry"/></mxCell><mxCell id="be_policy" value="&lt;b style=&quot;font-size:13px&quot;&gt;Policy engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;decides every check · issues signed grants to workers · logs every decision&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="80" y="340" width="200" height="660" as="geometry"/></mxCell><mxCell id="be_router" value="&lt;b style=&quot;font-size:13px&quot;&gt;Router agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;classify the ask · pick agent + skills&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="330" y="390" width="290" height="56" as="geometry"/></mxCell><mxCell id="be_registry" value="&lt;b style=&quot;font-size:13px&quot;&gt;Agent and skill registry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;agents · skills · versions · bindings&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="390" width="290" height="56" as="geometry"/></mxCell><mxCell id="be_runtime" value="&lt;b style=&quot;font-size:13px&quot;&gt;Runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;validate plan · dispatch · budget · replan&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="465" width="290" height="56" as="geometry"/></mxCell><mxCell id="be_review" value="&lt;b style=&quot;font-size:13px&quot;&gt;Review&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;clarification · approval · verdict&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fillColor=#ffffff;strokeColor