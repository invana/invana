Cell><mxCell id="cta3_2" value="sent to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts3_2" target="cts3_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ctc4" value="&lt;b style=&quot;font-size:14px&quot;&gt;From nowhere&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;nothing holds it&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#4d7c0f&quot;&gt;● Cite the origin&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_cites"><mxGeometry x="40" y="1880" width="290" height="64" as="geometry"/></mxCell><mxCell id="cts4_0" value="&lt;b&gt;Answer&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="370" y="1890.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cts4_1" value="&lt;b&gt;“I cannot answer that”&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_cites"><mxGeometry x="680" y="1890.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="cta4_0" value="says so" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#4d7c0f;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4d7c0f;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_cites" source="cts4_0" target="cts4_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="plh" value="&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; color=&quot;#8691a2&quot;&gt;&lt;b&gt;ACCESS POLICY&lt;/b&gt;&lt;/font&gt;   &lt;font color=&quot;#4f5a6b&quot;&gt;one record says who may do what, on which resource, in every layer — it replaces envelope and lens&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=12;" vertex="1" parent="L_policy"><mxGeometry x="40" y="2026" width="1600" height="24" as="geometry"/></mxCell><mxCell id="pp_part0" value="&lt;b style=&quot;font-size:15px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;Principal&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8691a2&quot;&gt;who acts&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; style=&quot;font-size:11px&quot;&gt;user/ravi · group/analysts&lt;br&gt;agent/modeler · worker/pool-gpu&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="40" y="2062" width="396" height="92" as="geometry"/></mxCell><mxCell id="pp_part1" value="&lt;b style=&quot;font-size:15px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;Action&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8691a2&quot;&gt;what it does&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; style=&quot;font-size:11px&quot;&gt;agent:invoke · skill:offer · skill:publish&lt;br&gt;callable:run · data:read · connector:send&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="458" y="2062" width="396" height="92" as="geometry"/></mxCell><mxCell id="pp_part2" value="&lt;b style=&quot;font-size:15px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;Resource&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8691a2&quot;&gt;on what&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; style=&quot;font-size:11px&quot;&gt;skill/import-dataset@3 · callable/write_records&lt;br&gt;graph/neo4j/airways/Supplier · mail/acme.com&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="876" y="2062" width="396" height="92" as="geometry"/></mxCell><mxCell id="pp_part3" value="&lt;b style=&quot;font-size:15px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;Condition&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8691a2&quot;&gt;only when&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; style=&quot;font-size:11px&quot;&gt;args.model = Supplier · tokens ≤ 50k&lt;br&gt;pool = on-prem · on behalf of a member&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="1294" y="2062" width="396" height="92" as="geometry"/></mxCell><mxCell id="pp_part4" value="&lt;b style=&quot;font-size:15px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;Effect&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#8691a2&quot;&gt;the answer&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot; style=&quot;font-size:11px&quot;&gt;allow · deny&lt;br&gt;deny always wins&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="1712" y="2062" width="396" height="92" as="geometry"/></mxCell><mxCell id="prc0" value="&lt;b style=&quot;font-size:14px&quot;&gt;How a grant is made&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;the run gets only what every policy allows&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;● Govern access&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="40" y="2214" width="290" height="64" as="geometry"/></mxCell><mxCell id="prs0_0" value="&lt;b&gt;User’s policy&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="370" y="2224.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs0_1" value="&lt;b&gt;Agent’s policy&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="680" y="2224.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs0_2" value="&lt;b&gt;Parent run’s grant&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="990" y="2224.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs0_3" value="&lt;b&gt;Effective grant&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="1300" y="2224.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="pra0_0" value="∩" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_policy" source="prs0_0" target="prs0_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pra0_1" value="∩" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_policy" source="prs0_1" target="prs0_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pra0_2" value="=" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;labelBackgroundColor=#ffffff;" edge="1" parent="L_policy" source="prs0_2" target="prs0_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="prc1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Where it is checked&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;four gates, the last on the worker itself&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;font color=&quot;#b42318&quot;&gt;● Govern access&lt;/font&gt; · &lt;font color=&quot;#c27a0e&quot;&gt;● Trace&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="40" y="2306" width="290" height="64" as="geometry"/></mxCell><mxCell id="prs1_0" value="&lt;b&gt;Bind a skill&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="370" y="2316.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs1_1" value="&lt;b&gt;Validate the plan&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="680" y="2316.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs1_2" value="&lt;b&gt;Dispatch a task&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="990" y="2316.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs1_3" value="&lt;b&gt;Worker runs a call&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="1300" y="2316.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs1_4" value="&lt;b&gt;Decision in trace&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-