t;&gt;&lt;font color=&quot;#b42318&quot;&gt;● Govern access&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;align=left;spacingLeft=12;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_policy"><mxGeometry x="40" y="2398" width="290" height="64" as="geometry"/></mxCell><mxCell id="prs2_0" value="&lt;b&gt;A call&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="370" y="2408.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs2_1" value="&lt;b&gt;Denied&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#fdf0ef;strokeColor=#b42318;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="680" y="2408.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs2_2" value="&lt;b&gt;Approval asked&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="990" y="2408.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="prs2_3" value="&lt;b&gt;Refused · policy named&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#f6f7f9;strokeColor=#8691a2;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;fontSize=11;" vertex="1" parent="L_policy"><mxGeometry x="1300" y="2408.0" width="160" height="44" as="geometry"/></mxCell><mxCell id="pra2_0" value="hits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#b42318;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b42318;