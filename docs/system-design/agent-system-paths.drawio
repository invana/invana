&lt;td rowspan=&quot;4&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Router agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;classify-ask&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Read the ask, pick the agent and the skills to offer it, record the route&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;llm&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;the route, on the run&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;clarify&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Ask the user when the ask is ambiguous, with options, instead of guessing&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;human&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the user’s answer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;hand-off&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Send a plan, context and budget slice to another agent; take the result back&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;work_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the child run&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;compose-answer&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Merge the agents’ results into one answer; drop any claim without a source&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;llm&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;each claim’s origin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;4&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Analyst agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;query-graph&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Write and run a Cypher or Gremlin query through the graph connector&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;graph_read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;graph records&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;explore-neighbours&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Expand around a node to find connected evidence&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;graph_read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;graph records&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;read-dataset&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Query a dataset CSV with DuckDB, inside the worker&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;data:read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;dataset rows&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;say-cannot-answer&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;When nothing in the graph or datasets holds it, say so&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;—&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the empty result&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;10&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Connector skills&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;query-source&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Run a read-only SQL query on a connected Postgres or Snowflake; snapshot the result&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;artifact → touch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;introspect-source&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Read a connected source’s tables and columns into a source schema&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the source schema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;register-api&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Read an OpenAPI spec; turn each operation into a callable an admin enables&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;schema:write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the spec version&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;find-operation&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Search a registered API’s operations by what they do, not the whole spec&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;—&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the spec version&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;call-api&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Call an enabled API operation with typed arguments; keep request and response&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read · send&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;artifact → touch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;call-tool&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Call an enabled MCP tool; keep its input and output&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read · send&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;artifact → touch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;sync-stream&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Copy a source stream into a dataset CSV with Airbyte&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;data:write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;each row → its source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;web-search&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Search the internet; keep the results as an artifact&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;artifact → touch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;fetch-file&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Download a file or page; store a snapshot&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:read&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;artifact → touch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;send-mail&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Send an email or a message; record exactly what was sent&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;connector:send&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the sent message&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;8&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Modeler agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;design-model&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Propose node and edge types, keys and constraints from a description or a dataset&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;schema_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;the dataset it read&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;version-model&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Draft, diff and publish a model version&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;schema_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the version&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;connect-source&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Connect a CSV, JSON, table, Snowflake or Postgres source&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;network&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;create-dataset&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Save a CSV, JSON or source query as a dataset CSV; profile and type its columns&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;data:write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the source&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;map-dataset&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Map dataset columns to the model’s node types, edge types and properties&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;schema_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the mapping&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;validate-records&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Check every row against the mapping; reject with a reason, never silently&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;ingest&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the validation report&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;import-dataset&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Write the mapped records into the graph database&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;graph_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;each record → its source row&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;stitch-models&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Declare where two models meet (anchors, cross-model edges)&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;schema_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the stitch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;1&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Coder agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;run-code&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Run a script on a worker to scrape, transform or compute&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;code_exec&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;the script and its output, as artifacts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;3&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Judge agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;run-benchmark&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Run a skill’s cases on a pinned graph and pinned models&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;work_write&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;the eval runs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;judge-answer&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Grade an answer against what is expected; check every claim is cited&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;llm&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the case&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;compare-baseline&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Score against the published version; block publish on a regression&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;—&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the scorecard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td rowspan=&quot;3&quot; style=&quot;padding:5px 10px;vertical-align:top;border-top:1px solid #8691a2&quot;&gt;&lt;b&gt;Every agent&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;cite-source&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;Attach the origin to every claim: graph record, dataset row or artifact&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;—&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #8691a2;color:#4d7c0f&quot;&gt;the claim’s origin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;snapshot-artifact&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Turn any third-party read into a stored artifact before using it&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;network&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;artifact&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;&lt;b&gt;ask-approval&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;Pause before a costly or outward act; a person decides&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4f5a6b&quot;&gt;&lt;font face=&quot;IBM Plex Mono, Menlo, monospace&quot;&gt;human&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 10px;border-top:1px solid #d9dee6;color:#4d7c0f&quot;&gt;the decision&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="L_skills"><mxGeometry x="40" y="3740" width="2130" height="974" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Entity detail" id="detail"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2160" pageHeight="900"><root><mxCell id="0"/><mxCell id="base" value="Entities" parent="0"/><mxCell id="L_ask" value="Path · Ask and answer" parent="0"/><mxCell id="L_handoff" value="Path · Hand off" parent="0"/><mxCell id="L_execute" value="Path · Execute" parent="0"/><mxCell id="L_model" value="Path · Model and import" parent="0"/><mxCell id="L_cite" value="Path · Cite the origin" parent="0"/><mxCell id="L_trace" value="Path · Trace" parent="0"/><mxCell id="L_eval" value="Path · Evaluate" parent="0"/><mxCell id="L_deploy" value="Path · Deploy" parent="0"/><mxCell id="L_policy" value="Path · Govern access" parent="0"/><mxCell id="dtitle" value="&lt;b style=&quot;font-size:22px&quot;&gt;Entity detail&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot;&gt;Every entity and every action between them. Toggle layers (Ctrl+Shift+L) to see one path alone.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="40" y="10" width="1600" height="56" as="geometry"/></mxCell><mxCell id="e_user" value="&lt;b style=&quot;font-size:14px&quot;&gt;User&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;asks, reads the answer&lt;/font&gt;" style="rounded=1;arcSize=50;fillColor=#eef3ff;strokeColor=#4f5a6b;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="40" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_router" value="&lt;b style=&quot;font-size:14px&quot;&gt;Router agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;classifies, hands off, answers&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#ffffff;strokeColor=#1b2330;strokeWidth=1.5;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans, Helvetica, Arial, sans-serif;fontColor=#1b2330;" vertex="1" parent="base"><mxGeometry x="350" y="110" width="220" height="64" as="geometry"/></mxCell><mxCell id="e_spec" value="&lt;b style=&quot;font-size:14px&quot;&gt;Specialist agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4f5a6b&quot; style=&quot;font-size:11px&quot;&gt;analyst · research · coder&lt;/font&gt;" style="rounded=1;arcSize=10;fillColor=#f