{
  "format": "invana.model/1",
  "package_id": "invana.dataset.arabidopsis",
  "content_hash": "",
  "name": "Arabidopsis",
  "description": "Accessions, the centres that hold them, the genes they carry, their traits and crosses.",
  "version": "1.0.0",
  "model": {
    "schema_name": "Arabidopsis",
    "schema_description": "Accessions, the centres that hold them, the genes they carry, their traits and crosses.",
    "validation_mode": "strict",
    "version": "1.0.0",
    "axes": {
      "geo": {
        "property": "country",
        "vocab": "iso2"
      },
      "dims": [
        "habit"
      ]
    },
    "property_keys": [
      {
        "name": "name",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "The name an accession, centre, institute, trait or gene is known by — the key.",
        "validation_rules": []
      },
      {
        "name": "stock_id",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "The stock centre's catalogue number.",
        "validation_rules": []
      },
      {
        "name": "country",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "Two-letter country code — where it was collected, or where the centre is.",
        "validation_rules": []
      },
      {
        "name": "habit",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "rapid cycling · winter annual — whether it flowers without vernalization.",
        "validation_rules": [
          {
            "rule_type": "enum",
            "params": {
              "values": [
                "rapid cycling",
                "winter annual"
              ]
            }
          }
        ]
      },
      {
        "name": "days_to_flowering",
        "type": "integer",
        "value_cardinality": "SINGLE",
        "description": "Days from sowing to the first open flower, long days, under drought.",
        "validation_rules": [
          {
            "rule_type": "range",
            "params": {
              "min": 15,
              "max": 150
            }
          }
        ]
      },
      {
        "name": "rosette_leaf_number",
        "type": "integer",
        "value_cardinality": "SINGLE",
        "description": "Rosette leaves at bolting.",
        "validation_rules": [
          {
            "rule_type": "range",
            "params": {
              "min": 4,
              "max": 100
            }
          }
        ]
      },
      {
        "name": "drought_survival_pct",
        "type": "float",
        "value_cardinality": "SINGLE",
        "description": "Plants that recover after 14 days without water, in percent.",
        "validation_rules": [
          {
            "rule_type": "range",
            "params": {
              "min": 0,
              "max": 100
            }
          }
        ]
      },
      {
        "name": "delta13c",
        "type": "float",
        "value_cardinality": "SINGLE",
        "description": "Carbon isotope ratio δ13C, in ‰ — less negative is more water-use efficient.",
        "validation_rules": [
          {
            "rule_type": "range",
            "params": {
              "min": -36,
              "max": -24
            }
          }
        ]
      },
      {
        "name": "city",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "Where the centre or institute is.",
        "validation_rules": []
      },
      {
        "name": "term_id",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "The Plant Trait Ontology (TO) term, when the trait has one.",
        "validation_rules": []
      },
      {
        "name": "unit",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "What the trait is measured in.",
        "validation_rules": []
      },
      {
        "name": "locus",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "The TAIR locus id, e.g. AT5G10140.",
        "validation_rules": []
      },
      {
        "name": "function",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "What the gene does, in one line.",
        "validation_rules": []
      },
      {
        "name": "allele",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "functional · loss-of-function — the allele the accession carries.",
        "validation_rules": [
          {
            "rule_type": "enum",
            "params": {
              "values": [
                "functional",
                "loss-of-function"
              ]
            }
          }
        ]
      },
      {
        "name": "cross_id",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "The cross, as female × male — the key.",
        "validation_rules": []
      },
      {
        "name": "status",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "proposed · made · parked · dropped.",
        "validation_rules": [
          {
            "rule_type": "enum",
            "params": {
              "values": [
                "proposed",
                "made",
                "parked",
                "dropped"
              ]
            }
          }
        ]
      },
      {
        "name": "generation",
        "type": "string",
        "value_cardinality": "SINGLE",
        "description": "How far the cross has gone: F1 · F2 · F3 · RIL.",
        "validation_rules": [
          {
            "rule_type": "enum",
            "params": {
              "values": [
                "F1",
                "F2",
                "F3",
                "RIL"
              ]
            }
          }
        ]
      }
    ],
