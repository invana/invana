{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/e2e/.auth",
			"!**/test-results",
			"!**/playwright-report",
			"!**/blob-report"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["@/pages/graphs-detail/features/*/**"],
								"message": "Import another module through its index.ts (code-shape.md §4.1)."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**", "!**/*.test.ts", "!**/*.test.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noFocusedTests": "off"
					}
				}
			}
		},
		{
			"includes": ["src/pages/graphs-detail/features/agents/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/pages/graphs-detail/features/*/**",
											"!@/pages/graphs-detail/features/agents/**"
										],
										"message": "Import another module through its index.ts (code-shape.md §4.1)."
									},
									{
										"group": ["@/pages/graphs-detail/shell/**"],
										"message": "Only the page imports the shell — shell → features → shared (code-shape.md §4)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
