{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/e2e/.auth",
			"!**/test-results",
			"!**/playwright-report",
			"!**/blob-report"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/studio/src/**",
				"packages/*/src/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noFocusedTests": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
