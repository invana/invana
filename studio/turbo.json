{
	"$schema": "https://turborepo.com/schema.json",
	"agentGuidance": false,
	"globalPassThroughEnv": ["CI"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["VITE_*", "INVANA_DESIGN_KIT", "INVANA_CANVAS"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"outputs": ["coverage/**"]
		},
		"knip": {},
		"dev": {
			"env": ["VITE_*", "INVANA_DESIGN_KIT", "INVANA_CANVAS"],
			"cache": false,
			"persistent": true
		}
	}
}
