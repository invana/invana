		"@codemirror/view": "^6.43.13",
		"@invana/canvas": "^0.0.15",
		"@invana/canvas-react": "^0.0.15",
		"@invana/canvas-ui": "^0.0.15",
		"@invana/charts": "^0.0.34",
		"@invana/blocks": "^0.0.34",
		"@invana/boards": "^0.0.34",
		"@invana/editor": "^0.0.34",
		"@invana/forms": "^0.0.34",
		"@invana/graph": "^0.0.15",
		"@invana/graph-layer-d3-contour": "^0.0.15",
		"@invana/graph-layer-maplibre": "^0.0.15",
		"@invana/graph-layout-d3-force": "^0.0.15",
		"@invana/graph-layout-d3-sankey": "^0.0.15",
		"@invana/graph-layout-elkjs": "^0.0.15",
		"@invana/renderer-pixijs": "^0.0.15",
		"@invana/styling": "^0.0.34",
		"@invana/tables": "^0.0.34",
		"@invana/themes": "^0.0.34",
		"@invana/ui": "^0.0.34",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/api-logs": "0.222.0",
		"@opentelemetry/context-zone": "2.11.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.222.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.222.0",
		"@opentelemetry/resources": "2.11.0",
