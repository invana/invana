		"@opentelemetry/sdk-metrics": "2.11.0",
		"@opentelemetry/sdk-trace-web": "2.11.0",
		"@tanstack/react-query": "^5.104.1",
		"axios": "^1.20.0",
		"elkjs": "^0.12.0",
		"lucide-react": "^1.52.0",
		"pixi-viewport": "^6.0.3",
		"pixi.js": "^8.22.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-router-dom": "^7.18.4",
		"sonner": "^2.0.8",
