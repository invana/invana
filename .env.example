# Single template for every optional env var in the repo. Copy to `.env`
# (repo root, gitignored) and fill in what you need — everything here is
# optional; unset vars fall back to safe dev defaults.
#
# ── Docker Compose ──────────────────────────────────────────────────────────
# docker-compose.yml reads this file automatically (same dir as the compose
# file) for its `${VAR}` substitutions. Vars below marked (compose) are wired
# into `engine`/`studio` there. Vars marked (compose default differs) get a
# *different* correct value inside the container than on your host — e.g.
# INVANA_DATABASE_URL resolves the Postgres container by its service name
# (`postgres`), not `localhost` — so docker-compose.yml keeps its own
# container-network default rather than sharing this file's value for those.
#
# ── Running engine/studio directly on your host (`make dev`, no Docker) ────
# pydantic-settings loads `engine/.env` (relative to the engine process's
# cwd) and Vite loads `studio/.env` / `studio/.env.local` (relative to
# `studio/`) — each independently of this file. Copy the relevant lines below
# into those instead, using host-appropriate values (e.g. `localhost` where a
# compose value would say `postgres`).

# ── Engine ───────────────────────────────────────────────────────────────
# All variables are prefixed with INVANA_ and loaded automatically.

# App
INVANA_APP_NAME=Invana
INVANA_APP_VERSION=0.0.0

# Core
INVANA_ENV=development
INVANA_DEBUG=false
INVANA_HOST=127.0.0.1
INVANA_PORT=8000
INVANA_LOG_LEVEL=DEBUG

# App-state database (PostgreSQL in prod, SQLite for local dev).
# (compose default differs) docker-compose.yml points the `engine` container
# at postgresql+asyncpg://invana_user:change_this_password@postgres:5432/invana_db
# — the value below is for running the engine directly on your host instead.
INVANA_DATABASE_URL=postgresql+asyncpg://invana_user:change_this_password@localhost:5432/invana_db
INVANA_DATABASE_POOL_SIZE=10
INVANA_DATABASE_MAX_OVERFLOW=20
INVANA_DATABASE_ECHO=false

# Auth (compose). Required in any non-development environment; fall back to
# insecure, fixed dev-only defaults when unset with INVANA_ENV=development.
INVANA_SECRET_KEY=
INVANA_ENCRYPTION_KEY=
INVANA_TOKEN_EXPIRY_MINUTES=1440

# Telemetry (OpenTelemetry) (compose: INVANA_TELEMETRY_ENABLED only — the
# rest matter when running the `telemetry` compose profile or on your host).
INVANA_TELEMETRY_ENABLED=true
INVANA_TELEMETRY_OTLP_ENDPOINT=http://localhost:4317
INVANA_TELEMETRY_SERVICE_NAME=invana-engine
INVANA_TELEMETRY_ENVIRONMENT=development

# ── Studio ───────────────────────────────────────────────────────────────

# Base URL for the Invana engine API (compose)
VITE_API_BASE_URL=http://localhost:8200

# Studio performance tracing (docs/for-developers/modules/platform/features/telemetry.md) (compose). On unless set to "false".
# Spans are exported via the engine proxy at
# ${VITE_API_BASE_URL}/api/v1/telemetry/traces.
VITE_TELEMETRY_ENABLED=true
