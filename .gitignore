*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.venv/
venv/
env/
.uv/

# ─── Node / Studio ───
node_modules/
studio/apps/*/dist/
studio/packages/*/dist/
*.tsbuildinfo
.vite/
.turbo/

# ─── Built Studio assets inside engine (generated) ───
engine/src/invana/studio/static/*
!engine/src/invana/studio/static/.gitkeep

# ─── IDE ───
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ─── Testing ───
.coverage
htmlcov/
.pytest_cache/
coverage/
test-results/
playwright-report/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Environment ───
.env
.env.local
.env.*.local

# ─── Docker ───
docker-compose.override.yml

# ─── Docs ───
docs/site/

# ─── Misc ───
*.log
*.bak
*.tmp
.ruff_cache/

.understand-anything/
# Local MCP servers — contains auth tokens
.mcp.json

# ─── Design canvas cache (scripts/design-pull.py) ───
.design/

# ─── pnpm's local content-addressable store (created by `pnpm add` in studio/) ───
studio/.pnpm-store/

# ─── Studio end-to-end tests ───
studio/apps/*/e2e/.auth/
studio/apps/*/test-results/
studio/apps/*/playwright-report/
studio/apps/*/blob-report/

# ─── Migration runner (scripts/migration) ───
.migration-cache/
