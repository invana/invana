# Invana Engine — environment configuration
# Copy to .env and adjust values for your setup.
# All variables are prefixed with INVANA_ and loaded automatically.

# App
INVANA_APP_NAME=Invana
INVANA_APP_VERSION=0.0.0

# Core
INVANA_ENV=development
INVANA_DEBUG=false
INVANA_HOST=127.0.0.1
INVANA_PORT=8000
INVANA_LOG_LEVEL=DEBUG

# App-state database (PostgreSQL in prod, SQLite for local dev)
INVANA_DATABASE_URL=postgresql+asyncpg://invana:invana@localhost:35432/invana
INVANA_DATABASE_POOL_SIZE=10
INVANA_DATABASE_MAX_OVERFLOW=20
INVANA_DATABASE_ECHO=false

# Auth
INVANA_SECRET_KEY=
INVANA_TOKEN_EXPIRY_MINUTES=1440

# Telemetry (OpenTelemetry)
INVANA_TELEMETRY_ENABLED=true
INVANA_TELEMETRY_OTLP_ENDPOINT=http://localhost:4317
INVANA_TELEMETRY_SERVICE_NAME=invana-engine
INVANA_TELEMETRY_ENVIRONMENT=development
